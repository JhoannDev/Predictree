# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo .env NO se sube a GitHub.

# Conexión a PostgreSQL: usuario:contraseña@servidor:puerto/base
DATABASE_URL=postgresql+psycopg://predictree_app:cambia_esta_clave@localhost:5432/predictree

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=pega_aqui_la_clave_generada
JWT_EXPIRE_MINUTES=480

# Dirección de la interfaz web que puede llamar a la API
CORS_ORIGINS=http://localhost:5173
